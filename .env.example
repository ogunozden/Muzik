# ===========================================
# Muzik - Ortam Değişkenleri (Environment Variables)
# ===========================================
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.

# Sound Engine - Gerçek ses örnekleri yokken sentetik sese düş
NEXT_PUBLIC_ENABLE_SYNTH_FALLBACK=true

# Database - SQLite veritabanı dosya adı
DATABASE_URL=sqlite.db

# Ensemble - Birlikte çalma signaling sunucusu adresi
NEXT_PUBLIC_SIGNALING_SERVER=http://localhost:3001

# ===========================================
# Muzik - Ortam Değişkenleri
# ===========================================
# Bu dosyayı .env.local olarak kopyalayın.

# Sound Engine - Gerçek ses örnekleri yokken sentetik sese düş
NEXT_PUBLIC_ENABLE_SYNTH_FALLBACK=true

# External Reference Operations - Yerel işlemler için ops token
EXTERNAL_REFERENCE_OPERATIONS_TOKEN=local-dev-token-change-in-production
EXTERNAL_REFERENCE_OPERATIONS_ALLOW_UNSAFE_LOCAL=true

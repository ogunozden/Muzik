{
  "version": 1,
  "policyVersion": "external-source-discovery-dry-run-v1",
  "defaultMode": "dry-run",
  "scope": "missing",
  "acceptedThreshold": 92,
  "scoringParams": {
    "baseWeightMultiplier": 60,
    "defaultTrustWeight": 0.5,
    "bonusPdfAndMusicxml": 10,
    "bonusPdfOnly": 6,
    "penaltyConflict": 30,
    "penaltyDeferred": 20,
    "maxDiscoveryScore": 89,
    "bucketMedium": 80,
    "bucketLow": 60
  },
  "cacheTtlDays": 14,
  "timeoutMs": 8000,
  "maxResponseBytes": 786432,
  "directAutoAttachAllowed": false,
  "writeSafety": {
    "dryRunDefault": true,
    "discoveryMayAttachDirectly": false,
    "acceptedReadyRequiresImportDryRun": true,
    "acceptedReadyImportTarget": "npm run import:external-references -- --input output/external-source-discovery/accepted-import-ready.json --dry-run"
  },
  "acceptedRequirements": [
    "https-url",
    "provider-profile-match",
    "catalog-id-or-deterministic-metadata-match",
    "duplicate-identity-free",
    "metadata-conflict-free",
    "checked-at-date",
    "complete-evidence",
    "provider-specific-verification",
    "confidence-threshold"
  ],
  "forbiddenAutomation": [
    "search-result-scraping-to-accepted",
    "pdf-audio-video-media-download",
    "remote-site-content-copy",
    "arbitrary-url-server-side-fetch",
    "unsupported-provider-endpoint",
    "write-before-clean-dry-run"
  ],
  "providers": [
    {
      "id": "internet-archive",
      "connector": "internet-archive",
      "mode": "structured-search-metadata",
      "baseUrl": "https://archive.org",
      "allowedHosts": ["archive.org"],
      "provider": "archive",
      "enabled": true,
      "rateLimitPerSecond": 1,
      "acceptedThreshold": 92,
      "scoringOverrides": {
        "titleWeight": 55,
        "composerWeight": 35,
        "makamWeight": 10,
        "usulWeight": 10,
        "formWeight": 10,
        "titleThreshold": 0.6,
        "composerThreshold": 0.5,
        "completeEvidenceTitle": 0.6,
        "completeEvidenceComposer": 0.5
      },
      "acceptedThreshold": 80,
      "verificationRequiredForAccepted": ["archive-metadata-title", "archive-item-identifier"]
    },
    {
      "id": "divanmakam",
      "connector": "known-site-search-url",
      "mode": "metadata-probe",
      "baseUrl": "https://divanmakam.com",
      "allowedHosts": ["divanmakam.com"],
      "provider": "score",
      "enabled": true,
      "rateLimitPerSecond": 1,
      "scoringOverrides": { "acceptedThreshold": 80 }
    },
    {
      "id": "ogm-materyal",
      "connector": "known-site-search-url",
      "mode": "metadata-probe",
      "baseUrl": "https://ogmmateryal.eba.gov.tr",
      "allowedHosts": ["ogmmateryal.eba.gov.tr"],
      "provider": "score",
      "enabled": true,
      "rateLimitPerSecond": 1,
      "scoringOverrides": { "acceptedThreshold": 80 }
    },
    {
      "id": "salihbora",
      "connector": "known-site-search-url",
      "mode": "metadata-probe",
      "baseUrl": "https://www.salihbora.com",
      "allowedHosts": ["salihbora.com"],
      "provider": "score",
      "enabled": true,
      "rateLimitPerSecond": 1,
      "scoringOverrides": { "acceptedThreshold": 80 }
    },
    {
      "id": "youtube-oembed",
      "connector": "youtube-oembed-verifier",
      "mode": "verification-only",
      "baseUrl": "https://www.youtube.com",
      "allowedHosts": ["youtube.com", "www.youtube.com", "youtu.be"],
      "provider": "youtube",
      "enabled": true,
      "rateLimitPerSecond": 1,
      "discoverBySearch": false,
      "verificationRequiredForAccepted": true
    }
  ]
}

{
  "name": "muzik",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "guardrails:architecture": "node scripts/validate-architecture.mjs",
    "guardrails:layout": "node scripts/validate-route-layout.mjs",
    "audit:bundle-size": "node scripts/audit-bundle-size.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "audit:symbtr-layout": "node scripts/audit-symbtr-layout-sources.mjs",
    "audit:symbtr-pdf-measures": "node scripts/extract-symbtr-pdf-measures.mjs --all --summary-output output/symbtr-layout-review/pdf-measure-extraction-summary.json",
    "audit:samples": "vitest run src/engines/ses/__tests__/sample-library.test.ts src/engines/ses/__tests__/sample-coverage.test.ts src/app/api/samples/__tests__/route.test.ts",
    "audit:studio-follow": "node scripts/audit-studio-follow-browser.mjs --base-url http://localhost:4015 --summary-output output/playwright/studio-follow-browser-audit-20260601.json --screenshot-output output/playwright/studio-follow-browser-audit-20260601.png",
    "audit:score-engine-engraving": "node scripts/audit-score-engine-engraving.mjs --base-url http://localhost:4015 --summary-output output/playwright/score-engine-engraving-audit.json --screenshot-output output/playwright/score-engine-engraving-audit.png",
    "audit:score-engine-focused-crops": "node scripts/audit-score-engine-focused-crops.mjs --base-url http://localhost:4015 --summary-output output/playwright/score-engine-focused-crops/summary.json",
    "audit:score-engine-focused-crops:strict": "node scripts/audit-score-engine-focused-crops.mjs --base-url http://localhost:4015 --summary-output output/playwright/score-engine-focused-crops/strict-summary.json --strict-glyph-coverage",
    "audit:score-engine-symbolic-corpus": "node scripts/audit-score-engine-symbolic-glyph-corpus.mjs",
    "audit:references-curation-runtime": "node scripts/audit-references-curation-runtime.mjs --base-url http://localhost:4015",
    "audit:external-references": "node scripts/audit-external-reference-coverage.mjs",
    "audit:prod-cycle": "node scripts/audit-prod-cycle.mjs --base-url http://localhost:4015 --summary-output output/external-reference-coverage/prod-cycle-summary.json",
    "audit:prod-closure": "node scripts/audit-prod-closure.mjs",
    "discover:external-sources": "node scripts/discover-external-sources.mjs --scope missing --providers internet-archive,divanmakam,ogm-materyal,salihbora --dry-run",
    "suggest:external-sources:gemini": "node scripts/suggest-external-sources-gemini.mjs --limit 5",
    "verify:external-source-discovery": "node scripts/verify-external-source-discovery.mjs",
    "verify:external-source-providers": "node scripts/verify-external-source-providers.mjs --provider all --limit 25 --rows 3",
    "verify:external-source-providers:continue": "node scripts/run-provider-verification-batches.mjs --provider all --batches 1 --limit 25 --rows 3",
    "stage:external-source": "node scripts/stage-external-sources.mjs",
    "stage:external-sources": "node scripts/stage-external-sources.mjs",
    "stage:source-terminal-decisions": "node scripts/stage-source-terminal-decisions.mjs",
    "stage:pdf-terminal-decisions": "node scripts/stage-pdf-terminal-decisions.mjs",
    "run:prod-closure-source-batches": "node scripts/run-prod-closure-source-batches.mjs",
    "map:external-references": "node scripts/map-external-source-inbox.mjs",
    "import:external-references": "node scripts/import-external-reference-candidates.mjs",
    "verify:external-source-intake": "node scripts/verify-external-source-intake-import.mjs --summary-output output/external-reference-coverage/source-intake-accepted-import-dry-run.json",
    "import:candidate-review-decisions": "node scripts/import-candidate-review-group-decisions.mjs",
    "sync:external-references": "node scripts/map-external-source-inbox.mjs --write",
    "curation:validate": "node scripts/validate-source-curation.mjs",
    "curation:auto-attach": "node scripts/manage-source-curation.mjs auto-attach --write",
    "curation:stats": "node scripts/manage-source-curation.mjs stats --write",
    "extract:symbtr-measures": "node scripts/extract-symbtr-pdf-measures.mjs",
    "review:symbtr-measures": "node scripts/render-symbtr-pdf-layout-review.mjs --all",
    "import:symbtr-measure-verification": "node scripts/import-symbtr-layout-verification.mjs",
    "verify:symbtr-layout-review-import": "node scripts/verify-symbtr-layout-review-import.mjs --summary-output output/symbtr-layout-review/layout-verification-empty-import-dry-run.json",
    "verify:symbtr-measures": "node scripts/validate-symbtr-layout-verification.mjs --summary-output output/symbtr-layout-review/layout-verification-summary.json",
    "verify:symbtr-measures:aligned": "node scripts/verify-pdf-measures-symbtr-aligned.mjs",
    "ai:verify-symbtr-layout": "node scripts/ai-verify-symbtr-layout.mjs",
    "test:visual-regression": "vitest run scripts/__tests__/visual-regression.test.mjs",
    "precommit": "npm run guardrails:architecture && npx lint-staged && npm run test:run",
    "quality": "npm run precommit && npm run audit:security",
    "audit:security": "npm audit --audit-level=moderate",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fetch:symbtr-v3": "node scripts/fetch-symbtr-v3.mjs",
    "derive:usul-meters": "node scripts/derive-usul-corpus-meters.mjs",
    "derive:makam-corpus": "node scripts/derive-makam-corpus.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "server-only": "^0.0.1",
    "vexflow": "^5.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@unocss/postcss": "^66.7.0",
    "@unocss/preset-wind4": "^66.7.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{mjs,js}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.0"
    },
    "next": {
      ".": "$next",
      "postcss": "8.5.15"
    }
  }
}
